# .env.example
# ---------------------------------------------
# Core Configuration for V2 2026 RAG System
# ---------------------------------------------

# --- VECTOR DATABASE (QDRANT) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=vnu_knowledge_v2

# --- RELATIONAL DATABASE (POSTGRESQL - V3 MVP) ---
DATABASE_URL=postgresql://admin:admin@pg_db:5432/rag_db

# --- V3 MINIO OBJECT STORAGE ---
MINIO_URL=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=raw-documents

# --- LOCAL INFERENCE (vLLM) ---
LOCAL_LLM_URL=http://host.docker.internal:8000/v1
LOCAL_LLM_KEY=dummy-token-for-local
LOCAL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# --- V2: CACHING & QUEUE (REDIS + CELERY) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- V2: DEEPSEEK OCR (API) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- V2: SECURITY (JWT) ---
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256